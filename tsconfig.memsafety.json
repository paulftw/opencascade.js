{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmitOnError": true,
    "outDir": "dist-memsafety",
    "rootDir": "."
  },
  "include": [
    "src/runtime/fr.ts",
    "tools/eslint-plugin/require-fr-wrapper.ts",
    "tools/eslint-plugin/memsafety.ts"
  ]
}
